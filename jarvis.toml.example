# Copy to jarvis.toml. Every key is optional; every key can also be set as an
# environment variable, e.g. JARVIS_MODEL=claude-sonnet-5.

[jarvis]
name = "JARVIS"
address_user_as = "sir"
wake_word = "jarvis"

# Reasoning path. Leave brain_enabled unset to switch it on automatically
# whenever the anthropic package and a credential are both present.
model = "claude-opus-5"
effort = "medium"          # low | medium | high | xhigh | max
max_tokens = 4096
max_tool_rounds = 6
# brain_enabled = true

# Reflex path. Raise it to send more to Claude, lower it to keep more local.
reflex_threshold = 0.55

# Memory
history_turns = 12
# data_dir = "~/.jarvis"

# Native voice (jarvis listen). The browser HUD does not use these.
speech_rate = 190
mute = false

# HUD server. Keep the host on loopback unless you know what you are exposing.
host = "127.0.0.1"
port = 7717

# Allow skills to open a browser window.
allow_launch = true
